# Para rodar localmente (npm run dev), copie para .env.local e cole a
# configuração do app web do Firebase em uma linha, por exemplo:
# VITE_FIREBASE_CONFIG={ apiKey: "...", authDomain: "...", databaseURL: "...", projectId: "...", storageBucket: "...", messagingSenderId: "...", appId: "..." }
VITE_FIREBASE_CONFIG=
