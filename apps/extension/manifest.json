{
  "manifest_version": 3,
  "name": "EchoRoom — tocar na sala",
  "short_name": "EchoRoom",
  "version": "1.2.1",
  "description": "Botão flutuante no YouTube que manda a música para a sua sala do EchoRoom ou para uma playlist sua.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir o EchoRoom",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://gustavotoigo-max.github.io/EchoRoom/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gustavotoigo-max.github.io/EchoRoom/*"
      ],
      "js": [
        "echoroom.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ]
}
